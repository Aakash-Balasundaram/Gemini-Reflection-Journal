# GEMINI_API_KEY: Required for Gemini AI API calls.
# Provide a valid Gemini API key from https://aistudio.google.com/apikey
# AI Studio injects this from the Settings > Secrets panel.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# Firebase Client Configuration (Optional overrides; defaults are loaded from firebase-applet-config.json)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID=""

# Google Maps API Keys (Directive 1)
# Browser key: Used strictly for Places Autocomplete and Maps JavaScript rendering.
# Restrict in Cloud Console: HTTP referrers to production/staging domain, APIs to Maps JS + Places API (New).
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_BROWSER_KEY=

# Server key: Used exclusively in server-side Place Details resolution. Never exposed to browser.
# Restrict in Cloud Console: IP-restricted to server egress, APIs to Places API (New) only.
GOOGLE_MAPS_SERVER_KEY=

# External Notifications (Directive 3)
# Secret webhooks and keys stored server-side. Never exposed to client.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
EMAIL_API_KEY=
NOTIFICATION_COOLDOWN_SECONDS=300

